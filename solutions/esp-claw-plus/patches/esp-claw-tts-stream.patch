+    lua_getfield(L, 2, "body");         /* +3 */
+    body = luaL_checkstring(L, -1);
+    lua_getfield(L, 2, "timeout_ms");   /* +4 */
+    timeout_ms = lua_isnil(L, -1) ? 0 : (int)luaL_checkinteger(L, -1);
