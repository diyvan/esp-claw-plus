+/*
+ * SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "esp_err.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * TTS 单向流式音频源 (边收边播)。
+ *
+ * 用法: 后台任务对 url 发起 POST, 增量解析 `{"code":0,"data":"<base64>"}` 形式的流式
+ * JSON, 把 data 解码后的音频字节推入内部环形缓冲; 音频播放器通过 cap_tts_stream_read()
+ * 以 raw:// 输入回调的形式拉取, 实现"边收边解码边播放"。
+ *
+ * 同一时刻只允许一个会话 (语音链路本身串行)。
+ */
+
+/**
+ * @brief 启动一个 TTS 流式会话 (后台任务异步执行)。
+ *
+ * @param[in] url         TTS endpoint (http/https)
+ * @param[in] headers     原始 header 块 (形如 "Name: Value\r\nName2: Value2\r\n"), 可为 NULL
+ * @param[in] body        POST body (JSON 字符串)
+ * @param[in] timeout_ms  HTTP socket 超时 (毫秒), <=0 取默认值
+ * @return ESP_OK 成功; 其它为失败 (参数错误 / 内存不足)
+ */
+esp_err_t cap_tts_stream_begin(const char *url, const char *headers, const char *body, int timeout_ms);
+
+/**
+ * @brief 从环形缓冲拉取最多 size 字节, 供 esp_audio_simple_player 的 raw:// 输入回调使用。
+ *        阻塞直到填满 size 字节、流结束、或超时。
+ *
+ * @return >0 实际读到的字节数 (== size 表示还有后续); 0 表示流已结束 (EOF); 负数表示错误
+ */
+int cap_tts_stream_read(uint8_t *data, int size, uint32_t timeout_ms);
+
+/**
+ * @brief 结束会话: 中止后台任务并释放缓冲。可重复调用 (幂等)。
+ */
+void cap_tts_stream_end(void);
+
+/**
+ * @brief 会话是否仍在进行 (HTTP 接收未结束)。
+ */
+bool cap_tts_stream_active(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/components/claw_capabilities/cap_tts_stream/src/cap_tts_stream.c b/components/claw_capabilities/cap_tts_stream/src/cap_tts_stream.c
new file mode 100644
index 0000000..a7b04a1
--- /dev/null
+++ b/components/claw_capabilities/cap_tts_stream/src/cap_tts_stream.c
@@ -0,0 +1,429 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "cap_tts_stream.h"
+
+#include <ctype.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cJSON.h"
+#include "esp_crt_bundle.h"
+#include "esp_http_client.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/stream_buffer.h"
+#include "freertos/task.h"
+#include "mbedtls/base64.h"
+
+static const char *TAG = "tts_stream";
+
+#define TTS_STREAM_SB_BYTES      (48 * 1024)
+#define TTS_STREAM_TASK_STACK    8192
+#define TTS_STREAM_TASK_PRIO     5
+#define TTS_STREAM_READ_CHUNK    512
+#define TTS_STREAM_DEFAULT_TO_MS 20000
+#define TTS_STREAM_SEND_TO_MS    1000
+
+typedef struct {
+    StreamBufferHandle_t sb;
+    TaskHandle_t task;
+    volatile bool running;
+    volatile bool abort;
+    volatile bool eof;
+
+    /* 会话参数 (由 begin 深拷贝, task 结束时释放) */
+    char *url;
+    char *headers;
+    char *body;
+    int timeout_ms;
+
+    /* 增量扫描 '"data"' + ':' + '"' + <base64> + '"' 的中间状态 (仅 task 使用) */
+    char *pending;
+    size_t pending_len;
+    size_t pending_cap;
+    uint8_t *scratch;
+    size_t scratch_cap;
+    bool in_value;
+    size_t pushed_bytes;
+} tts_stream_ctx_t;
+
+static tts_stream_ctx_t s_ctx;
+
+static const char TTS_FIELD_PATTERN[] = "\"data\"";
+
+static char *tts_find_char(const char *buf, size_t len, char c)
+{
+    for (size_t i = 0; i < len; i++) {
+        if (buf[i] == c) {
+            return (char *)(buf + i);
+        }
+    }
+    return NULL;
+}
+
+static char *tts_find_bytes(const char *buf, size_t len, const char *pat, size_t pat_len)
+{
+    if (pat_len == 0 || len < pat_len) {
+        return NULL;
+    }
+    for (size_t i = 0; i + pat_len <= len; i++) {
+        if (memcmp(buf + i, pat, pat_len) == 0) {
+            return (char *)(buf + i);
+        }
+    }
+    return NULL;
+}
+
+/* 把已解码的音频字节推入环形缓冲; 带背压 (缓冲满时阻塞等待消费端拉取)。 */
+static void tts_stream_push(const uint8_t *data, size_t len)
+{
+    size_t off = 0;
+
+    while (off < len && !s_ctx.abort) {
+        size_t sent = xStreamBufferSend(s_ctx.sb, data + off, len - off,
+                                        pdMS_TO_TICKS(TTS_STREAM_SEND_TO_MS));
+        if (sent == 0) {
+            /* 消费端长时间不拉取 (播放已停止) 或已 abort, 放弃剩余数据。 */
+            ESP_LOGW(TAG, "ring buffer stalled, dropping %zu bytes", len - off);
+            break;
+        }
+        off += sent;
+    }
+    s_ctx.pushed_bytes += off;
+}
+
+/* 解码一个 base64 分块并推入环形缓冲。坏块只告警跳过, 尽量保留可用音频。 */
+static void tts_stream_decode_chunk(const char *b64, size_t b64_len)
+{
+    size_t out_len = 0;
+    size_t need;
+
+    if (b64_len == 0) {
+        return;
+    }
+    need = ((b64_len + 3) / 4) * 3 + 4;
+    if (need > s_ctx.scratch_cap) {
+        uint8_t *grown = realloc(s_ctx.scratch, need);
+        if (!grown) {
+            ESP_LOGE(TAG, "out of memory for decode scratch");
+            return;
+        }
+        s_ctx.scratch = grown;
+        s_ctx.scratch_cap = need;
+    }
+    if (mbedtls_base64_decode(s_ctx.scratch, s_ctx.scratch_cap, &out_len,
+                              (const unsigned char *)b64, b64_len) != 0) {
+        ESP_LOGW(TAG, "base64 decode failed for a %zu-byte chunk", b64_len);
+        return;
+    }
+    if (out_len > 0) {
+        tts_stream_push(s_ctx.scratch, out_len);
+    }
+}
+
+/* 从 pending 缓冲增量扫描 '"data"' ':' '"' <base64> '"' 并逐块解码;
+ * 未闭合片段保留到下一批数据, 因此可跨 HTTP chunk 边界。 */
+static void tts_stream_scan(void)
+{
+    const size_t pat_len = sizeof(TTS_FIELD_PATTERN) - 1;
+    size_t pos = 0;
+
+    for (;;) {
+        size_t avail = s_ctx.pending_len - pos;
+
+        if (!s_ctx.in_value) {
+            char *hit = tts_find_bytes(s_ctx.pending + pos, avail, TTS_FIELD_PATTERN, pat_len);
+            size_t k;
+            size_t j;
+
+            if (!hit) {
+                /* 保留可能是被截断的模式前缀 (如结尾的 '"dat') */
+                size_t keep = pat_len - 1;
+                pos = (avail > keep) ? (s_ctx.pending_len - keep) : pos;
+                break;
+            }
+            k = (size_t)(hit - s_ctx.pending);
+            j = k + pat_len;
+            while (j < s_ctx.pending_len && isspace((unsigned char)s_ctx.pending[j])) {
+                j++;
+            }
+            if (j >= s_ctx.pending_len) {
+                pos = k;
+                break;
+            }
+            if (s_ctx.pending[j] != ':') {
+                pos = k + 1;
+                continue;
+            }
+            j++;
+            while (j < s_ctx.pending_len && isspace((unsigned char)s_ctx.pending[j])) {
+                j++;
+            }
+            if (j >= s_ctx.pending_len) {
+                pos = k;
+                break;
+            }
+            if (s_ctx.pending[j] != '"') {
+                /* 如 "data":null —— 此处没有 base64 值, 从该位置继续扫描 */
+                pos = j;
+                continue;
+            }
+            s_ctx.in_value = true;
+            pos = j + 1;
+        } else {
+            char *end = tts_find_char(s_ctx.pending + pos, s_ctx.pending_len - pos, '"');
+            size_t q;
+
+            if (!end) {
+                break;
+            }
+            q = (size_t)(end - s_ctx.pending);
+            tts_stream_decode_chunk(s_ctx.pending + pos, q - pos);
+            s_ctx.in_value = false;
+            pos = q + 1;
+        }
+    }
+
+    if (pos > 0) {
+        memmove(s_ctx.pending, s_ctx.pending + pos, s_ctx.pending_len - pos);
+        s_ctx.pending_len -= pos;
+    }
+}
+
+static bool tts_stream_pending_append(const char *data, size_t len)
+{
+    if (s_ctx.pending_len + len + 1 > s_ctx.pending_cap) {
+        size_t new_cap = s_ctx.pending_cap ? s_ctx.pending_cap * 2 : 8192;
+        char *grown;
+
+        if (new_cap < s_ctx.pending_len + len + 1) {
+            new_cap = s_ctx.pending_len + len + 1;
+        }
+        grown = realloc(s_ctx.pending, new_cap);
+        if (!grown) {
+            ESP_LOGE(TAG, "out of memory for pending buffer");
+            return false;
+        }
+        s_ctx.pending = grown;
+        s_ctx.pending_cap = new_cap;
+    }
+    memcpy(s_ctx.pending + s_ctx.pending_len, data, len);
+    s_ctx.pending_len += len;
+    s_ctx.pending[s_ctx.pending_len] = '\0';
+    return true;
+}
+
+static void tts_stream_apply_headers(esp_http_client_handle_t client, const char *headers)
+{
+    char *copy;
+    char *save = NULL;
+
+    if (!headers || !headers[0]) {
+        return;
+    }
+    copy = strdup(headers);
+    if (!copy) {
+        return;
+    }
+    for (char *line = strtok_r(copy, "\r\n", &save); line; line = strtok_r(NULL, "\r\n", &save)) {
+        char *colon = strchr(line, ':');
+        char *value;
+
+        if (!colon) {
+            continue;
+        }
+        *colon = '\0';
+        value = colon + 1;
+        while (*value == ' ') {
+            value++;
+        }
+        if (line[0]) {
+            esp_http_client_set_header(client, line, value);
+        }
+    }
+    free(copy);
+}
+
+static void tts_stream_task(void *arg)
+{
+    tts_stream_ctx_t *ctx = (tts_stream_ctx_t *)arg;
+    esp_http_client_config_t config = {
+        .url = ctx->url,
+        .method = HTTP_METHOD_POST,
+        .timeout_ms = ctx->timeout_ms > 0 ? ctx->timeout_ms : TTS_STREAM_DEFAULT_TO_MS,
+        .buffer_size = 4096,
+        .crt_bundle_attach = esp_crt_bundle_attach,
+        .disable_auto_redirect = true,
+    };
+    esp_http_client_handle_t client = esp_http_client_init(&config);
+    char chunk[TTS_STREAM_READ_CHUNK];
+    int body_len = (int)strlen(ctx->body);
+    int status = 0;
+
+    if (!client) {
+        ESP_LOGE(TAG, "http client init failed");
+        goto done;
+    }
+    tts_stream_apply_headers(client, ctx->headers);
+    esp_http_client_set_header(client, "Content-Type", "application/json");
+
+    if (esp_http_client_open(client, body_len) != ESP_OK) {
+        ESP_LOGE(TAG, "http open failed");
+        esp_http_client_cleanup(client);
+        goto done;
+    }
+    if (esp_http_client_write(client, ctx->body, body_len) != body_len) {
+        ESP_LOGE(TAG, "http write failed");
+        esp_http_client_cleanup(client);
+        goto done;
+    }
+    esp_http_client_fetch_headers(client);
+    status = esp_http_client_get_status_code(client);
+    if (status < 200 || status >= 300) {
+        ESP_LOGE(TAG, "TTS http status=%d", status);
+        esp_http_client_cleanup(client);
+        goto done;
+    }
+
+    for (;;) {
+        int r;
+
+        if (ctx->abort) {
+            break;
+        }
+        r = esp_http_client_read(client, chunk, sizeof(chunk));
+        if (r <= 0) {
+            break;
+        }
+        if (!tts_stream_pending_append(chunk, (size_t)r)) {
+            break;
+        }
+        tts_stream_scan();
+    }
+
+    /* 处理收尾残留 (未以 '"' 闭合的尾部直接丢弃) */
+    tts_stream_scan();
+    esp_http_client_cleanup(client);
+
+done:
+    ESP_LOGI(TAG, "session done: pushed=%zu bytes, status=%d", ctx->pushed_bytes, status);
+    ctx->eof = true;
+    ctx->running = false;
+    vTaskDelete(NULL);
+}
+
+esp_err_t cap_tts_stream_begin(const char *url, const char *headers, const char *body, int timeout_ms)
+{
+    if (!url || !body) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    /* 清理上一个会话可能残留的资源 (即使其后台任务已自然结束) */
+    cap_tts_stream_end();
+
+    s_ctx.abort = false;
+    s_ctx.eof = false;
+    s_ctx.in_value = false;
+    s_ctx.pending_len = 0;
+    s_ctx.pushed_bytes = 0;
+    s_ctx.url = strdup(url);
+    s_ctx.headers = headers ? strdup(headers) : NULL;
+    s_ctx.body = strdup(body);
+    s_ctx.timeout_ms = timeout_ms;
+    if (!s_ctx.url || !s_ctx.body) {
+        goto fail;
+    }
+    s_ctx.sb = xStreamBufferCreate(TTS_STREAM_SB_BYTES, 1);
+    if (!s_ctx.sb) {
+        ESP_LOGE(TAG, "stream buffer create failed");
+        goto fail;
+    }
+    s_ctx.running = true;
+    if (xTaskCreate(tts_stream_task, "tts_stream", TTS_STREAM_TASK_STACK, &s_ctx,
+                    TTS_STREAM_TASK_PRIO, &s_ctx.task) != pdPASS) {
+        ESP_LOGE(TAG, "task create failed");
+        s_ctx.running = false;
+        vStreamBufferDelete(s_ctx.sb);
+        s_ctx.sb = NULL;
+        goto fail;
+    }
+    return ESP_OK;
+
+fail:
+    free(s_ctx.url);
+    free(s_ctx.headers);
+    free(s_ctx.body);
+    s_ctx.url = NULL;
+    s_ctx.headers = NULL;
+    s_ctx.body = NULL;
+    return ESP_ERR_NO_MEM;
+}
+
+int cap_tts_stream_read(uint8_t *data, int size, uint32_t timeout_ms)
+{
+    size_t got = 0;
+
+    if (!data || size <= 0) {
+        return -1;
+    }
+    if (!s_ctx.sb) {
+        return 0;
+    }
+    while (got < (size_t)size) {
+        size_t n = xStreamBufferReceive(s_ctx.sb, data + got, (size_t)size - got,
+                                        pdMS_TO_TICKS(timeout_ms));
+        if (n > 0) {
+            got += n;
+            continue;
+        }
+        break;  /* eof / abort / 超时: 返回已读部分 */
+    }
+    if (got == 0 && !s_ctx.eof) {
+        ESP_LOGW(TAG, "read timeout with no data (eof=%d, running=%d)",
+                 (int)s_ctx.eof, (int)s_ctx.running);
+    }
+    return (int)got;
+}
+
+bool cap_tts_stream_active(void)
+{
+    return s_ctx.running;
+}
+
+void cap_tts_stream_end(void)
+{
+    if (!s_ctx.sb && !s_ctx.running && !s_ctx.url) {
+        return;
+    }
+    s_ctx.abort = true;
+    /* 等后台任务自行收尾 (HTTP read 会周期性返回, 通常 <200ms) */
+    for (int i = 0; i < 300 && s_ctx.running; i++) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    if (s_ctx.running) {
+        ESP_LOGW(TAG, "task did not exit in time, force delete");
+        vTaskDelete(s_ctx.task);
+        s_ctx.running = false;
+    }
+    if (s_ctx.sb) {
+        vStreamBufferDelete(s_ctx.sb);
+        s_ctx.sb = NULL;
+    }
+    free(s_ctx.url);
+    free(s_ctx.headers);
+    free(s_ctx.body);
+    s_ctx.url = NULL;
+    s_ctx.headers = NULL;
+    s_ctx.body = NULL;
+    free(s_ctx.pending);
+    s_ctx.pending = NULL;
+    s_ctx.pending_cap = 0;
+    s_ctx.pending_len = 0;
+    free(s_ctx.scratch);
+    s_ctx.scratch = NULL;
+    s_ctx.scratch_cap = 0;
+    s_ctx.in_value = false;
+    s_ctx.eof = false;
+}
