+/* 把 Lua 表 {Name=Value, ...} 拼成 "Name: Value\r\n" 原始 header 块。返回 malloc 字符串 (调用方 free)。 */
+static char *audio_player_build_headers(lua_State *L, int idx)
+{
+    size_t cap = 256;
+    size_t len = 0;
+    char *buf = (char *)malloc(cap);
+
+    if (!buf) {
+        return NULL;
+    }
+    buf[0] = '\0';
+    lua_pushnil(L);
+    while (lua_next(L, idx) != 0) {
+        if (lua_type(L, -2) == LUA_TSTRING && lua_type(L, -1) == LUA_TSTRING) {
+            const char *name = lua_tostring(L, -2);
+            const char *value = lua_tostring(L, -1);
+            size_t need = strlen(name) + strlen(value) + 4;
+
+            if (len + need + 1 > cap) {
+                char *grown;
+
+                while (len + need + 1 > cap) {
+                    cap *= 2;
+                }
+                grown = (char *)realloc(buf, cap);
+                if (!grown) {
+                    free(buf);
+                    lua_pop(L, 2);
+                    return NULL;
+                }
+                buf = grown;
+            }
+            len += (size_t)snprintf(buf + len, cap - len, "%s: %s\r\n", name, value);
+        }
+        lua_pop(L, 1);
+    }
+    return buf;
+}
