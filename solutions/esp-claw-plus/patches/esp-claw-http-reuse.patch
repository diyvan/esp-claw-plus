--- a/application/edge_agent/sdkconfig.defaults
+++ b/application/edge_agent/sdkconfig.defaults
@@ -79,8 +79,15 @@
 CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
 CONFIG_BT_CTRL_BLE_SCAN_DUPL=n
 
-# See https://github.com/espressif/esp-claw/issues/101
-CONFIG_HTTP_REUSE_ENABLE=n
+# Upstream ships the HTTP client reuse pool disabled by default
+# (see https://github.com/espressif/esp-claw/issues/101: PSRAM growth observed
+# on ESP32-S3 with SPIRAM_MALLOC_ALWAYSINTERNAL=0 during continuous requests).
+# This board is ESP32-P4 + 32MB PSRAM and the voice loop pays a full TLS
+# handshake on every LLM round-trip, so re-enable the pool and keep it small
+# (each idle entry holds one socket) to leave room for the ASR WebSocket and
+# the device HTTP server. See docs/voice-integration.md §7 §⑤.
+CONFIG_HTTP_REUSE_ENABLE=y
+CONFIG_HTTP_REUSE_MAX_POOL=4
 
 # Audio Decoder Configuration
 CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
--- a/components/claw_capabilities/cap_http_request/src/cap_http_request.c
+++ b/components/claw_capabilities/cap_http_request/src/cap_http_request.c
@@ -770,6 +770,11 @@
     config.buffer_size = 4096;
     config.crt_bundle_attach = esp_crt_bundle_attach;
     config.disable_auto_redirect = true;
+#ifdef CONFIG_HTTP_REUSE_ENABLE
+    /* Opt in to the http_reuse connection pool so repeated calls to the same
+     * endpoint (e.g. per-sentence non-stream TTS) reuse the TCP/TLS session. */
+    config.keep_alive_enable = true;
+#endif
 
     client = esp_http_client_init(&config);
     if (!client) {
