new file mode 100644
index 0000000..1213983
--- /dev/null
+++ b/components/common/ha_voice_arbiter/ha_voice_arbiter.c
@@ -0,0 +1,126 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "ha_voice_arbiter.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+
+static const char *TAG = "ha_voice_arb";
+
+/* Binary semaphore: given == microphone is free. */
+static SemaphoreHandle_t s_mic_sem;
+/* Advisory flags, only meaningful once the arbiter is initialised. */
+static volatile bool s_capture_active;
+static volatile bool s_handoff;
+
+static bool ha_voice_arbiter_ready(void)
+{
+    return s_mic_sem != NULL;
+}
+
+esp_err_t ha_voice_arbiter_init(void)
+{
+    if (s_mic_sem != NULL) {
+        return ESP_OK;
+    }
+
+    SemaphoreHandle_t sem = xSemaphoreCreateBinary();
+    if (sem == NULL) {
+        ESP_LOGE(TAG, "failed to create microphone semaphore");
+        return ESP_ERR_NO_MEM;
+    }
+    xSemaphoreGive(sem);
+
+    s_capture_active = false;
+    s_handoff = false;
+    s_mic_sem = sem;
+
+    ESP_LOGI(TAG, "microphone arbiter ready");
+    return ESP_OK;
+}
+
+bool ha_voice_arbiter_acquire(uint32_t timeout_ms)
+{
+    if (!ha_voice_arbiter_ready()) {
+        return true; /* degrade to no arbitration */
+    }
+
+    s_capture_active = true;
+
+    if (xSemaphoreTake(s_mic_sem, pdMS_TO_TICKS(timeout_ms)) == pdTRUE) {
+        ESP_LOGD(TAG, "capture acquired microphone");
+        return true;
+    }
+
+    s_capture_active = false;
+    ESP_LOGW(TAG, "capture acquire timed out after %u ms", (unsigned)timeout_ms);
+    return false;
+}
+
+void ha_voice_arbiter_release(void)
+{
+    if (!ha_voice_arbiter_ready()) {
+        return;
+    }
+
+    s_capture_active = false;
+    s_handoff = false;
+    xSemaphoreGive(s_mic_sem);
+    ESP_LOGD(TAG, "capture released microphone");
+}
+
+bool ha_voice_arbiter_afe_acquire(uint32_t timeout_ms)
+{
+    if (!ha_voice_arbiter_ready()) {
+        return true; /* degrade to no arbitration */
+    }
+
+    TickType_t deadline = xTaskGetTickCount() + pdMS_TO_TICKS(timeout_ms);
+    while (s_handoff || s_capture_active) {
+        if (xTaskGetTickCount() >= deadline) {
+            /* A capture session would have started by now; drop a stale handoff
+             * so the listener can resume even if no recording follows the wake. */
+            if (s_capture_active) {
+                return false; /* never preempt an in-flight capture */
+            }
+            ESP_LOGW(TAG, "dropping stale handoff");
+            s_handoff = false;
+            break;
+        }
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+
+    if (xSemaphoreTake(s_mic_sem, pdMS_TO_TICKS(timeout_ms)) == pdTRUE) {
+        return true;
+    }
+
+    return false;
+}
+
+void ha_voice_arbiter_afe_release(void)
+{
+    if (!ha_voice_arbiter_ready()) {
+        return;
+    }
+
+    /* Keep s_handoff untouched: a pending handoff must survive until the
+     * capture side releases the mic. */
+    xSemaphoreGive(s_mic_sem);
+}
+
+bool ha_voice_arbiter_yield_requested(void)
+{
+    return s_capture_active || s_handoff;
+}
+
+void ha_voice_arbiter_hold_for_capture(void)
+{
+    s_handoff = true;
+}
diff --git a/components/common/ha_voice_arbiter/include/ha_voice_arbiter.h b/components/common/ha_voice_arbiter/include/ha_voice_arbiter.h
new file mode 100644
index 0000000..9f9ff07
--- /dev/null
+++ b/components/common/ha_voice_arbiter/include/ha_voice_arbiter.h
@@ -0,0 +1,101 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "esp_err.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Microphone arbiter.
+ *
+ * The board exposes a single I2S RX path (one physical microphone). Two
+ * independent consumers need it at different times:
+ *
+ *   - "listener": the always-on WakeNet front-end (ha_voice_wake.c), which
+ *     keeps the codec open at 48 kHz / 2 ch and runs the AFE in the back.
+ *   - "capture" : a Lua recording session (voice_ptt.lua) opened on demand.
+ *
+ * The listener is the long-running owner; the capture is the short, latency
+ * sensitive owner. Rules:
+ *
+ *   - Only one of them may hold the mic at a time.
+ *   - A capture request always wins: the listener must yield within one
+ *     feed/fetch cycle, never preempt an in-flight capture.
+ *   - After a wake the listener voluntarily stays off the mic until the
+ *     capture session finishes (handoff), so the very first words are not
+ *     swallowed by the front-end.
+ *
+ * If the arbiter was never initialised all APIs degrade to "no arbitration":
+ * acquire succeeds and yield is never requested, preserving legacy behaviour.
+ */
+
+/**
+ * @brief Initialise the arbiter. Idempotent. Safe to call from any task.
+ *
+ * @return ESP_OK on success, or an error code.
+ */
+esp_err_t ha_voice_arbiter_init(void);
+
+/**
+ * @brief Capture side: request exclusive access to the microphone.
+ *
+ * Blocks up to @p timeout_ms while the listener still owns the mic. The
+ * listener notices the request on its next loop iteration and yields.
+ *
+ * @param timeout_ms Maximum time to wait.
+ * @return true if the mic is now owned by the caller, false otherwise.
+ */
+bool ha_voice_arbiter_acquire(uint32_t timeout_ms);
+
+/**
+ * @brief Capture side: release the microphone and clear any pending handoff.
+ */
+void ha_voice_arbiter_release(void);
+
+/**
+ * @brief Listener side: try to acquire the microphone for wake-word detection.
+ *
+ * Waits up to @p timeout_ms while a capture session is active or a handoff is
+ * pending. A capture session is never preempted. If a stale handoff survives
+ * the whole timeout it is dropped, so the listener can recover even if no
+ * capture session follows the wake.
+ *
+ * @param timeout_ms Maximum time to wait.
+ * @return true if the listener now owns the mic, false otherwise.
+ */
+bool ha_voice_arbiter_afe_acquire(uint32_t timeout_ms);
+
+/**
+ * @brief Listener side: release the microphone.
+ *
+ * Does not clear a pending handoff, so the listener will not immediately
+ * re-grab the mic after a wake.
+ */
+void ha_voice_arbiter_afe_release(void);
+
+/**
+ * @brief Listener side: whether a capture session wants / has the microphone.
+ *
+ * The listener polls this from its feed/fetch loop and bails out promptly when
+ * it returns true.
+ */
+bool ha_voice_arbiter_yield_requested(void);
+
+/**
+ * @brief Listener side: mark that a wake was detected and the mic is being
+ *        handed over to the capture side.
+ */
+void ha_voice_arbiter_hold_for_capture(void);
+
+#ifdef __cplusplus
+}
+#endif
