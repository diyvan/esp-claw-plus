diff --git a/components/lua_modules/lua_module_display/src/lua_module_display.c b/components/lua_modules/lua_module_display/src/lua_module_display.c
index 092e9e8..ecdba3a 100644
--- a/components/lua_modules/lua_module_display/src/lua_module_display.c
+++ b/components/lua_modules/lua_module_display/src/lua_module_display.c
@@ -28,6 +28,11 @@
 
 static const char *TAG = "lua_display";
 
+/* Set only by a successful display.init(); the exit hook must not release a
+ * claim this module never acquired (another owner, e.g. the C panel, may hold
+ * the arbiter under DISPLAY_ARBITER_OWNER_LUA). */
+static bool s_display_owned;
+
 /* -------------------------------------------------------------------------
  * Argument helpers (mirrors the reference implementation)
  * ---------------------------------------------------------------------- */
@@ -156,12 +161,17 @@ static void lua_display_exit_cleanup(lua_State *L)
 {
     (void)L;
 
+    if (!s_display_owned) {
+        return;
+    }
     if (!display_arbiter_is_owner(DISPLAY_ARBITER_OWNER_LUA)) {
+        s_display_owned = false;
         return;
     }
     ESP_LOGI(TAG, "Lua exit cleanup: display still owned by Lua, releasing");
 
     if (display_hal_destroy() == ESP_OK) {
+        s_display_owned = false;
         display_arbiter_release(DISPLAY_ARBITER_OWNER_LUA);
     }
 }
@@ -188,6 +198,7 @@ static int lua_display_init(lua_State *L)
         return luaL_error(L, "display init failed: %s", esp_err_to_name(err));
     }
 
+    s_display_owned = true;
     lua_pushboolean(L, 1);
     return 1;
 }
@@ -205,6 +216,7 @@ static int lua_display_deinit(lua_State *L)
         return luaL_error(L, "display release failed: %s", esp_err_to_name(err));
     }
 
+    s_display_owned = false;
     lua_pushboolean(L, 1);
     return 1;
 }
