+/* ------------------------------------------------------------------------- */
+/* Streaming (SSE) support                                                    */
+/* ------------------------------------------------------------------------- */
+
+typedef struct {
+    char *id;
+    char *name;
+    char *arguments;
+} stream_tool_call_t;
+
+typedef struct {
+    const claw_llm_chat_request_t *request;
+    char *text;
+    size_t text_len;
+    size_t text_cap;
+    char *reasoning;
+    size_t reasoning_len;
+    size_t reasoning_cap;
+    stream_tool_call_t *tool_calls;
+    size_t tool_call_count;
+    size_t tool_call_cap;
+    bool saw_delta;
+    bool tool_call_seen;
+} openai_stream_state_t;
+
+static esp_err_t stream_text_append(char **buf, size_t *len, size_t *cap, const char *frag)
+{
+    size_t frag_len;
+
+    if (!frag || !frag[0]) {
+        return ESP_OK;
+    }
+    frag_len = strlen(frag);
+    if (*len + frag_len + 1 > *cap) {
+        size_t new_cap = (*cap == 0) ? 256 : *cap;
+        char *grown;
+
+        while (*len + frag_len + 1 > new_cap) {
+            new_cap *= 2;
+        }
+        grown = realloc(*buf, new_cap);
+        if (!grown) {
+            return ESP_ERR_NO_MEM;
+        }
+        *buf = grown;
+        *cap = new_cap;
+    }
+    memcpy(*buf + *len, frag, frag_len);
+    *len += frag_len;
+    (*buf)[*len] = '\0';
+    return ESP_OK;
+}
+
+static stream_tool_call_t *stream_tool_call_slot(openai_stream_state_t *state, int index)
+{
+    if (index < 0) {
+        return NULL;
+    }
+    if ((size_t)index >= state->tool_call_cap) {
+        size_t new_cap = state->tool_call_cap ? state->tool_call_cap : 4;
+        stream_tool_call_t *grown;
+
+        while (new_cap <= (size_t)index) {
+            new_cap *= 2;
+        }
+        grown = realloc(state->tool_calls, new_cap * sizeof(*grown));
+        if (!grown) {
+            return NULL;
+        }
+        memset(grown + state->tool_call_cap, 0,
+               (new_cap - state->tool_call_cap) * sizeof(*grown));
+        state->tool_calls = grown;
+        state->tool_call_cap = new_cap;
+    }
+    if ((size_t)index + 1 > state->tool_call_count) {
+        state->tool_call_count = (size_t)index + 1;
+    }
+    return &state->tool_calls[index];
+}
+
+static esp_err_t stream_tool_string_append(char **dst, const char *frag)
+{
+    size_t old_len;
+    size_t frag_len;
+    char *grown;
+
+    if (!frag || !frag[0]) {
+        return ESP_OK;
+    }
+    old_len = *dst ? strlen(*dst) : 0;
+    frag_len = strlen(frag);
+    grown = realloc(*dst, old_len + frag_len + 1);
+    if (!grown) {
+        return ESP_ERR_NO_MEM;
+    }
+    memcpy(grown + old_len, frag, frag_len);
+    grown[old_len + frag_len] = '\0';
+    *dst = grown;
+    return ESP_OK;
+}
+
+static void openai_stream_on_sse(const char *data, size_t len, void *user_ctx)
+{
+    openai_stream_state_t *state = (openai_stream_state_t *)user_ctx;
+    cJSON *root;
+    cJSON *choices;
+    cJSON *choice0;
+    cJSON *delta;
+    cJSON *content;
+    cJSON *reasoning;
+    cJSON *tool_calls;
+
+    (void)len;
+    if (!state || !data || !data[0]) {
+        return;
+    }
+    if (strcmp(data, "[DONE]") == 0) {
+        return;
+    }
+
+    root = cJSON_Parse(data);
+    if (!root) {
+        return;
+    }
+    choices = cJSON_GetObjectItem(root, "choices");
+    choice0 = (choices && cJSON_IsArray(choices)) ? cJSON_GetArrayItem(choices, 0) : NULL;
+    delta = choice0 ? cJSON_GetObjectItem(choice0, "delta") : NULL;
+    if (!delta || !cJSON_IsObject(delta)) {
+        cJSON_Delete(root);
+        return;
+    }
+
+    state->saw_delta = true;
+
+    content = cJSON_GetObjectItem(delta, "content");
+    if (content && cJSON_IsString(content) && content->valuestring && content->valuestring[0]) {
+        if (state->request && state->request->on_delta && !state->tool_call_seen) {
+            state->request->on_delta(content->valuestring, state->request->on_delta_user_ctx);
+        }
+        stream_text_append(&state->text, &state->text_len, &state->text_cap, content->valuestring);
+    }
+
+    reasoning = cJSON_GetObjectItem(delta, "reasoning_content");
+    if (reasoning && cJSON_IsString(reasoning) && reasoning->valuestring) {
+        stream_text_append(&state->reasoning, &state->reasoning_len, &state->reasoning_cap,
+                           reasoning->valuestring);
+    }
+
+    tool_calls = cJSON_GetObjectItem(delta, "tool_calls");
+    if (tool_calls && cJSON_IsArray(tool_calls)) {
+        cJSON *tc;
+
+        cJSON_ArrayForEach(tc, tool_calls) {
+            cJSON *index_json = cJSON_GetObjectItem(tc, "index");
+            int index = (index_json && cJSON_IsNumber(index_json)) ? (int)index_json->valuedouble : 0;
+            stream_tool_call_t *slot = stream_tool_call_slot(state, index);
+            cJSON *id_json;
+            cJSON *fn;
+
+            if (!slot) {
+                continue;
+            }
+            state->tool_call_seen = true;
+
+            id_json = cJSON_GetObjectItem(tc, "id");
+            if (id_json && cJSON_IsString(id_json) && id_json->valuestring) {
+                stream_tool_string_append(&slot->id, id_json->valuestring);
+            }
+            fn = cJSON_GetObjectItem(tc, "function");
+            if (fn && cJSON_IsObject(fn)) {
+                cJSON *name_json = cJSON_GetObjectItem(fn, "name");
+                cJSON *args_json = cJSON_GetObjectItem(fn, "arguments");
+
+                if (name_json && cJSON_IsString(name_json) && name_json->valuestring) {
+                    stream_tool_string_append(&slot->name, name_json->valuestring);
+                }
+                if (args_json && cJSON_IsString(args_json) && args_json->valuestring) {
+                    stream_tool_string_append(&slot->arguments, args_json->valuestring);
+                }
+            }
+        }
+    }
+
+    cJSON_Delete(root);
+}
+
+static void openai_stream_state_free(openai_stream_state_t *state)
+{
+    size_t i;
+
+    if (!state) {
+        return;
+    }
+    free(state->text);
+    free(state->reasoning);
+    for (i = 0; i < state->tool_call_count; i++) {
+        free(state->tool_calls[i].id);
+        free(state->tool_calls[i].name);
+        free(state->tool_calls[i].arguments);
+    }
+    free(state->tool_calls);
+    memset(state, 0, sizeof(*state));
+}
+
+/* Rebuild a non-streaming shaped body from the accumulated deltas and reuse
+ * parse_chat_response() so validation/allocation logic stays identical. */
+static esp_err_t openai_stream_finalize(openai_stream_state_t *state,
+                                        claw_llm_response_t *out_response,
+                                        char **out_error_message)
+{
+    cJSON *root = cJSON_CreateObject();
+    cJSON *choices;
+    cJSON *choice;
+    cJSON *message;
+    char *body;
+    esp_err_t err;
+
+    if (!root) {
+        *out_error_message = dup_printf("Out of memory finalizing stream");
+        return ESP_ERR_NO_MEM;
+    }
+    choices = cJSON_CreateArray();
+    if (!choices) {
+        cJSON_Delete(root);
+        *out_error_message = dup_printf("Out of memory finalizing stream");
+        return ESP_ERR_NO_MEM;
+    }
+    cJSON_AddItemToObject(root, "choices", choices);
+
+    choice = cJSON_CreateObject();
+    if (!choice) {
+        cJSON_Delete(root);
+        *out_error_message = dup_printf("Out of memory finalizing stream");
+        return ESP_ERR_NO_MEM;
+    }
+    cJSON_AddItemToArray(choices, choice);
+
+    message = cJSON_CreateObject();
+    if (!message) {
+        cJSON_Delete(root);
+        *out_error_message = dup_printf("Out of memory finalizing stream");
+        return ESP_ERR_NO_MEM;
+    }
+    cJSON_AddItemToObject(choice, "message", message);
+
+    cJSON_AddStringToObject(message, "role", "assistant");
+    cJSON_AddStringToObject(message, "content", state->text ? state->text : "");
+    if (state->reasoning && state->reasoning[0]) {
+        cJSON_AddStringToObject(message, "reasoning_content", state->reasoning);
+    }
+
+    if (state->tool_call_count > 0) {
+        cJSON *tool_calls = cJSON_CreateArray();
+        size_t i;
+
+        if (!tool_calls) {
+            cJSON_Delete(root);
+            *out_error_message = dup_printf("Out of memory finalizing stream");
+            return ESP_ERR_NO_MEM;
+        }
+        cJSON_AddItemToObject(message, "tool_calls", tool_calls);
+
+        for (i = 0; i < state->tool_call_count; i++) {
+            cJSON *tc = cJSON_CreateObject();
+            cJSON *fn = cJSON_CreateObject();
+
+            if (!tc || !fn) {
+                cJSON_Delete(root);
+                *out_error_message = dup_printf("Out of memory finalizing stream");
+                return ESP_ERR_NO_MEM;
+            }
+            cJSON_AddStringToObject(tc, "id",
+                                    state->tool_calls[i].id ? state->tool_calls[i].id : "");
+            cJSON_AddStringToObject(tc, "type", "function");
+            cJSON_AddStringToObject(fn, "name",
+                                    state->tool_calls[i].name ? state->tool_calls[i].name : "");
+            cJSON_AddStringToObject(fn, "arguments",
+                                    state->tool_calls[i].arguments ? state->tool_calls[i].arguments : "");
+            cJSON_AddItemToObject(tc, "function", fn);
+            cJSON_AddItemToArray(tool_calls, tc);
+        }
+    }
+
+    body = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!body) {
+        *out_error_message = dup_printf("Out of memory serializing stream result");
+        return ESP_ERR_NO_MEM;
+    }
+
+    err = parse_chat_response(body, out_response, out_error_message);
+    free(body);
+    return err;
+}
+
+static esp_err_t openai_compatible_chat_stream(openai_compatible_backend_ctx_t *ctx,
+                                               const claw_llm_model_profile_t *profile,
+                                               const claw_llm_chat_request_t *request,
+                                               claw_llm_response_t *out_response,
+                                               char **out_error_message)
+{
+    claw_llm_http_json_request_t http_request = {0};
+    claw_llm_http_response_t http_response = {0};
+    openai_stream_state_t state = {0};
+    char *url = NULL;
+    char *post_data = NULL;
+    esp_err_t err;
+
+    err = build_chat_body(ctx, profile, request, true, &post_data, out_error_message);
+    if (err != ESP_OK) {
+        return err;
+    }
+
+    url = join_url(ctx->base_url, profile->chat_path);
+    if (!url) {
+        free(post_data);
+        *out_error_message = dup_printf("Out of memory building API URL");
+        return ESP_ERR_NO_MEM;
+    }
+
+    state.request = request;
+    http_request.url = url;
+    http_request.body = post_data;
+    http_request.api_key = ctx->api_key;
+    http_request.auth_type = ctx->auth_type;
+    http_request.timeout_ms = ctx->timeout_ms;
+    http_request.abort_flag = request->abort_flag;
+    http_request.on_sse_data = openai_stream_on_sse;
+    http_request.sse_data_user_ctx = &state;
+
+    err = claw_llm_http_post_json(&http_request, &http_response, out_error_message);
+    free(url);
+    free(post_data);
+    if (err != ESP_OK) {
+        openai_stream_state_free(&state);
+        return err;
+    }
+
+    if (!state.saw_delta) {
+        /* Server ignored stream:true and returned a plain JSON body. */
+        err = parse_chat_response(http_response.body, out_response, out_error_message);
+    } else {
+        err = openai_stream_finalize(&state, out_response, out_error_message);
+    }
+
+    claw_llm_http_response_free(&http_response);
+    openai_stream_state_free(&state);
+    return err;
+}
