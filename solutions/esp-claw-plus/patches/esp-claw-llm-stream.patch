+/* -------------------------------------------------------------------------
+ * Voice streaming sink
+ *
+ * For voice turns the router sets CLAW_CORE_REQUEST_FLAG_STREAM_REPLY. The LLM
+ * backend then streams incremental assistant text through on_delta; we append
+ * it to a small FATFS file that the resident voice_ptt.lua consumer polls, so
+ * TTS can start before the whole reply is ready. The file is truncated at
+ * request start and terminated with an end marker at request end.
+ * ------------------------------------------------------------------------- */
+#define CLAW_CORE_STREAM_SINK_PATH "/fatfs/voice_stream.txt"
+#define CLAW_CORE_STREAM_SINK_FLUSH_BYTES 12
+#define CLAW_CORE_STREAM_SINK_END_MARKER "\x01\x01" "END" "\x01\x01"
+
+typedef struct {
+    FILE *fp;
+    size_t pending;
+    bool emitted;
+} claw_core_stream_sink_t;
+
+static void claw_core_stream_sink_open(claw_core_stream_sink_t *sink)
+{
+    if (!sink) {
+        return;
+    }
+    sink->fp = fopen(CLAW_CORE_STREAM_SINK_PATH, "wb");
+    sink->pending = 0;
+    sink->emitted = false;
+    if (!sink->fp) {
+        ESP_LOGW(TAG, "voice stream sink open failed: %s", CLAW_CORE_STREAM_SINK_PATH);
+        return;
+    }
+    fflush(sink->fp);
+    fsync(fileno(sink->fp));
+}
+
+static void claw_core_stream_sink_delta(const char *text_delta, void *user_ctx)
+{
+    claw_core_stream_sink_t *sink = (claw_core_stream_sink_t *)user_ctx;
+    size_t len;
+
+    if (!sink || !sink->fp || !text_delta) {
+        return;
+    }
+    len = strlen(text_delta);
+    if (len == 0 || fwrite(text_delta, 1, len, sink->fp) != len) {
+        return;
+    }
+    sink->emitted = true;
+    sink->pending += len;
+    if (sink->pending >= CLAW_CORE_STREAM_SINK_FLUSH_BYTES) {
+        fflush(sink->fp);
+        fsync(fileno(sink->fp));
+        sink->pending = 0;
+    }
+}
+
+static void claw_core_stream_sink_close(claw_core_stream_sink_t *sink)
+{
+    static const char end_marker[] = CLAW_CORE_STREAM_SINK_END_MARKER;
+
+    if (!sink || !sink->fp) {
+        return;
+    }
+    fwrite(end_marker, 1, sizeof(end_marker) - 1, sink->fp);
+    fflush(sink->fp);
+    fsync(fileno(sink->fp));
+    fclose(sink->fp);
+    sink->fp = NULL;
+}
