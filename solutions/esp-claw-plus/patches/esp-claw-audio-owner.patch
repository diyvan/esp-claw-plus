+
+void ha_voice_pcm_downmix_decimate(const int16_t *in, int out_samples, int in_channels, int factor, int16_t *out)
+{
+    if (!in || !out || in_channels < 1 || factor < 1) {
+        return;
+    }
+    for (int i = 0; i < out_samples; i++) {
+        int32_t acc = 0;
+        for (int k = 0; k < factor; k++) {
+            const int16_t *frame = &in[(i * factor + k) * in_channels];
+            int32_t frame_sum = 0;
+            for (int ch = 0; ch < in_channels; ch++) {
+                frame_sum += frame[ch];
+            }
+            acc += frame_sum / in_channels;
+        }
+        out[i] = (int16_t)(acc / factor);
+    }
+}
