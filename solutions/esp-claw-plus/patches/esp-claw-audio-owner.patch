+/* Opening an output device asks the arbiter whether the speaker is free. It
+ * fails fast when a capture session is taking the shared codec, rather than
+ * letting two sample clocks fight over it. */
+#define AUDIO_OUTPUT_ARBITER_TIMEOUT_MS 200
+
+/* Every Lua device object of one kind wraps the same board codec handle (all
+ * outputs share audio_dac, all inputs share audio_adc), and both handles sit
+ * behind one chip on one I2S port. The handle must therefore be reference
+ * counted: the codec is opened by the first device and closed by the last.
+ * Closing on the first close would pull the codec out from under a sibling
+ * still streaming - the reboot seen when a recording tears down a concurrent
+ * playback. */
+#define AUDIO_CODEC_SLOTS 4
+static struct {
+    esp_codec_dev_handle_t handle;
+    int refs;
+} s_codec_slots[AUDIO_CODEC_SLOTS];
+static portMUX_TYPE s_codec_lock = portMUX_INITIALIZER_UNLOCKED;
+
+/* Returns true when this is the first reference, i.e. the codec must be opened. */
+static bool audio_codec_ref_add(esp_codec_dev_handle_t handle)
+{
+    bool first = false;
+    int free_slot = -1;
+
+    portENTER_CRITICAL(&s_codec_lock);
+    for (int i = 0; i < AUDIO_CODEC_SLOTS; i++) {
+        if (s_codec_slots[i].refs > 0 && s_codec_slots[i].handle == handle) {
+            s_codec_slots[i].refs++;
+            portEXIT_CRITICAL(&s_codec_lock);
+            return false;
+        }
+        if (free_slot < 0 && s_codec_slots[i].refs == 0) {
+            free_slot = i;
+        }
+    }
+    if (free_slot >= 0) {
+        s_codec_slots[free_slot].handle = handle;
+        s_codec_slots[free_slot].refs = 1;
+        first = true;
+    } else {
+        ESP_LOGW(TAG, "Codec ref table full, opening handle unconditionally");
+        first = true;
+    }
+    portEXIT_CRITICAL(&s_codec_lock);
+    return first;
+}
+
+/* Returns true when this was the last reference, i.e. the codec must be closed. */
+static bool audio_codec_ref_remove(esp_codec_dev_handle_t handle)
+{
+    bool last = false;
+
+    portENTER_CRITICAL(&s_codec_lock);
+    for (int i = 0; i < AUDIO_CODEC_SLOTS; i++) {
+        if (s_codec_slots[i].refs > 0 && s_codec_slots[i].handle == handle) {
+            last = (--s_codec_slots[i].refs == 0);
+            if (last) {
+                s_codec_slots[i].handle = NULL;
+            }
+            break;
+        }
+    }
+    portEXIT_CRITICAL(&s_codec_lock);
+    return last;
+}
