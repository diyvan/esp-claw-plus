+        ha_voice_pcm_downmix_decimate((const int16_t *)buf, out_samples, dev->fmt.channels,
+                                      (int)dev->decim_factor, (int16_t *)out);
+        lua_pushlstring(L, (const char *)out, out_bytes);
+        free(out);
+    } else {
+        lua_pushlstring(L, (const char *)buf, bytes);
+    }
     free(buf);
     return 1;
 }
