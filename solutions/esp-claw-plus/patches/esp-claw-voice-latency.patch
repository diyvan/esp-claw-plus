+/* 解码一个 base64 分块并追加写入 buf->file。坏块只记警告并跳过, 尽量保留可用音频。 */
+static esp_err_t cap_http_request_decode_chunk(cap_http_request_buf_t *buf,
+                                               const char *b64, size_t b64_len)
+{
+    size_t out_len = 0;
+    size_t need;
+
+    if (b64_len == 0) {
+        return ESP_OK;
+    }
+
+    need = ((b64_len + 3) / 4) * 3 + 4;
+    if (need > buf->decode_scratch_cap) {
+        uint8_t *grown = realloc(buf->decode_scratch, need);
+
+        if (!grown) {
+            return ESP_ERR_NO_MEM;
+        }
+        buf->decode_scratch = grown;
+        buf->decode_scratch_cap = need;
+    }
+
+    if (mbedtls_base64_decode(buf->decode_scratch, buf->decode_scratch_cap, &out_len,
+                              (const unsigned char *)b64, b64_len) != 0) {
+        buf->decode_chunk_errors++;
+        ESP_LOGW(TAG, "base64 decode failed for a %zu-byte chunk", b64_len);
+        return ESP_OK;
+    }
+    if (out_len == 0) {
+        return ESP_OK;
+    }
+    if (buf->max_file_bytes > 0 && buf->file_bytes + out_len > buf->max_file_bytes) {
+        out_len = buf->max_file_bytes - buf->file_bytes;
+        buf->truncated = true;
+    }
+    if (out_len > 0 && fwrite(buf->decode_scratch, 1, out_len, buf->file) != out_len) {
+        buf->file_write_failed = true;
+        return ESP_FAIL;
+    }
+    buf->file_bytes += out_len;
+    return ESP_OK;
+}
+
+/* 从 pending 缓冲里增量扫描 '"field"' + ':' + '"' + <base64> + '"' 并逐块解码。
+ * 未闭合的片段保留到下一批数据, 因此可跨 HTTP chunk 边界。 */
+static esp_err_t cap_http_request_decode_process(cap_http_request_buf_t *buf)
+{
+    size_t pos = 0;
+
+    for (;;) {
+        size_t avail = buf->pending_len - pos;
+
+        if (!buf->in_value) {
+            char *hit = cap_http_request_find_bytes(buf->pending + pos, avail,
+                                                    buf->decode_pattern, buf->decode_pattern_len);
+            size_t k;
+            size_t j;
+
+            if (!hit) {
+                /* 保留可能是被截断的模式前缀 (如结尾的 '"dat') */
+                size_t keep = buf->decode_pattern_len - 1;
+
+                pos = (avail > keep) ? (buf->pending_len - keep) : pos;
+                break;
+            }
+            k = (size_t)(hit - buf->pending);
+            j = k + buf->decode_pattern_len;
+            while (j < buf->pending_len && isspace((unsigned char)buf->pending[j])) {
+                j++;
+            }
+            if (j >= buf->pending_len) {
+                pos = k;
+                break;
+            }
+            if (buf->pending[j] != ':') {
+                pos = k + 1;
+                continue;
+            }
+            j++;
+            while (j < buf->pending_len && isspace((unsigned char)buf->pending[j])) {
+                j++;
+            }
+            if (j >= buf->pending_len) {
+                pos = k;
+                break;
+            }
+            if (buf->pending[j] != '"') {
+                /* 如 "data":null —— 此处没有 base64 值, 从该位置继续扫描 */
+                pos = j;
+                continue;
+            }
+            buf->in_value = true;
+            pos = j + 1;
+        } else {
+            char *end = cap_http_request_find_char(buf->pending + pos,
+                                                   buf->pending_len - pos, '"');
+            size_t q;
+            esp_err_t err;
+
+            if (!end) {
+                break;
+            }
+            q = (size_t)(end - buf->pending);
+            err = cap_http_request_decode_chunk(buf, buf->pending + pos, q - pos);
+            if (err != ESP_OK) {
+                return err;
+            }
+            buf->in_value = false;
+            pos = q + 1;
+        }
+    }
+
+    if (pos > 0) {
+        memmove(buf->pending, buf->pending + pos, buf->pending_len - pos);
+        buf->pending_len -= pos;
+    }
+    return ESP_OK;
+}
