+static char *cap_http_request_find_bytes(const char *hay, size_t hay_len,
+                                         const char *needle, size_t needle_len)
+{
+    size_t i;
+
+    if (!needle_len || hay_len < needle_len) {
+        return NULL;
+    }
+    for (i = 0; i + needle_len <= hay_len; i++) {
+        if (hay[i] == needle[0] && memcmp(hay + i, needle, needle_len) == 0) {
+            return (char *)hay + i;
+        }
+    }
+    return NULL;
+}
+
+static char *cap_http_request_find_char(const char *hay, size_t hay_len, char c)
+{
+    size_t i;
+
+    for (i = 0; i < hay_len; i++) {
+        if (hay[i] == c) {
+            return (char *)hay + i;
+        }
+    }
+    return NULL;
+}
