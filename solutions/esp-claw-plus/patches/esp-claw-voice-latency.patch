+static esp_err_t cap_http_request_pending_append(cap_http_request_buf_t *buf,
+                                                 const char *data, size_t len)
+{
+    char *grown = NULL;
+    size_t new_cap;
+
+    if (buf->pending_len + len + 1 > buf->pending_cap) {
+        new_cap = buf->pending_cap ? buf->pending_cap * 2 : 8192;
+        if (new_cap < buf->pending_len + len + 1) {
+            new_cap = buf->pending_len + len + 1;
+        }
+        grown = realloc(buf->pending, new_cap);
+        if (!grown) {
+            return ESP_ERR_NO_MEM;
+        }
+        buf->pending = grown;
+        buf->pending_cap = new_cap;
+    }
+    memcpy(buf->pending + buf->pending_len, data, len);
+    buf->pending_len += len;
+    buf->pending[buf->pending_len] = '\0';
+    return ESP_OK;
+}
